                <TextRuns>
                  <TextRun>
                    <Value>=IIF(
    IsNothing(Parameters!CompletedBy.Value)
    Or IsNothing(Parameters!DateCompleted.Value)
    Or Trim(Parameters!CompletedBy.Value) = ""
    Or Trim(Parameters!DateCompleted.Value) = ""
    Or UCase(Trim(Parameters!CompletedBy.Value)) = "N/A"
    Or UCase(Trim(Parameters!DateCompleted.Value)) = "N/A"
    Or UCase(Trim(Parameters!CompletedBy.Value)) = "PENDING"
    Or UCase(Trim(Parameters!DateCompleted.Value)) = "PENDING",
    "",
    "Completed by " &amp; Parameters!CompletedBy.Value &amp; 
    " on " &amp; Parameters!DateCompleted.Value
)</Value>
                    <Style>
                      <FontSize>7.5pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
